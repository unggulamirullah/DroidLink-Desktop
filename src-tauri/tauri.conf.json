{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DroidLink Desktop",
  "version": "0.1.0",
  "identifier": "com.droidlink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DroidLink Desktop",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Android screen mirroring and device control",
    "longDescription": "Mirror and control Android devices over USB or Wi-Fi using ADB and scrcpy.",
    "resources": [
      "resources/platform-tools/*",
      "resources/scrcpy/*"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
